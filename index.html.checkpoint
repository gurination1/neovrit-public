<!-- ════════════════════════════════════════════
     SECTION CONTACT — REACH OUT
     ════════════════════════════════════════════ -->
<section id="section-contact">

  <div class="sc-seam"></div>

  <div id="headset-bg" aria-hidden="true"></div>

  <!-- Corner terminal readouts — sideways decoration (merged from §5) -->
  <div class="cta-corner cta-corner-tl">SYS:READY<br>ENV:PROD</div>
  <div class="cta-corner cta-corner-tr">BUILD:2025.1<br>VER:2.0.0</div>
  <div class="cta-corner cta-corner-bl">UPTIME:100%<br>LAT:&lt;1MS</div>
  <div class="cta-corner cta-corner-br">GPU:ACTIVE<br>RENDER:OK</div>

  <!-- Aura rings — fading at lower half, after where the VR headset sits -->
  <div class="sc-rings-wrap">
    <div class="cta-ring cta-ring-1"></div>
    <div class="cta-ring cta-ring-2"></div>
    <div class="cta-ring cta-ring-3"></div>
  </div>

  <div class="sc-inner" id="sc-inner">

    <!-- LEFT: headline + cycling words + buttons -->
    <div class="sc-left">

      <div class="sc-eyebrow">
        <div class="sc-eyebrow-dash"></div>
        Get In Touch
      </div>

      <div class="sc-headline">
        Let's <em>build</em><br>something
      </div>

      <!-- cycling word slot -->
      <div class="sc-cycle-row" aria-live="polite">
        <span class="sc-cycle-word" data-word>together.</span>
        <span class="sc-cycle-word" data-word>immersive.</span>
        <span class="sc-cycle-word" data-word>powerful.</span>
        <span class="sc-cycle-word" data-word>real.</span>
        <span class="sc-cycle-word" data-word>alive.</span>
      </div>

      <p class="sc-sub">
        Have a project in mind? A simulation to build,<br>
        an AI pipeline to ship, or a world to render?<br>
        We respond within 24 hours.
      </p>

      <div class="sc-btns">
        <button class="sc-btn-main" id="btn-start-brief"><span>Request Live Demo →</span></button>
        <button class="sc-btn-ghost">future4orge@gmail.com</button>
      </div>

      <!-- Studio strip — compact identity line (merged from §5) -->
      <div class="sc-studio-strip">
        <span class="sc-strip-eyebrow">[ Ready To Build ]</span>
        <div class="sc-strip-headline">The world's most <em>immersive</em> training studio.</div>
        <div class="sc-strip-sub">Six disciplines · One platform · Zero compromises</div>
      </div>

    </div>

    <!-- RIGHT: contact form -->
    <div class="sc-form-panel mbrief-panel" id="mbrief-panel">

      <!-- Liquid Glass SVG Filter (hidden) -->
      <svg style="position:absolute;width:0;height:0;overflow:hidden;" aria-hidden="true">
        <defs>
          <filter id="liquid-glass-blur" x="-5%" y="-5%" width="110%" height="110%" color-interpolation-filters="sRGB">
            <feTurbulence type="fractalNoise" baseFrequency="0.004 0.008" numOctaves="1" result="turbulence" seed="3"/>
            <feDisplacementMap in="SourceGraphic" in2="turbulence" scale="6" xChannelSelector="R" yChannelSelector="G" result="displaced"/>
            <feComposite in="displaced" in2="SourceGraphic" operator="atop"/>
          </filter>
        </defs>
      </svg>

      <!-- Left edge shimmer -->
      <div class="mbrief-panel-ledge"></div>

      <!-- Panel Header -->
      <div class="mb-header">
        <div class="mb-header-left">
          <div class="mb-tag">MISSION BRIEF</div>
          <div class="mb-tag-sub">// INTEL PROTOCOL</div>
        </div>
        <div class="mb-step-counter">
          <span class="mb-step-current">01</span><span class="mb-step-sep"> / 06</span>
        </div>
      </div>

      <!-- Progress Bar -->
      <div class="mb-progress-track">
        <div class="mb-progress-fill" id="mb-progress-fill"></div>
        <div class="mb-progress-comet" id="mb-progress-comet"></div>
      </div>

      <!-- Step Label -->
      <div class="mb-step-label" id="mb-step-label">STEP 01 / 06</div>

      <!-- Steps Container -->
      <div class="mb-steps-container" id="mb-steps-container">

        <!-- STEP 01 — OPERATIVE -->
        <div class="mb-step" id="mb-step-01">
          <div class="mb-question" id="mb-q-01"></div>
          <input type="text" class="mb-input" id="mb-input-operative" placeholder="Your full name" autocomplete="off" />
          <div class="mb-sub-label">Identify yourself to proceed.</div>
        </div>

        <!-- STEP 02 — COMMS -->
        <div class="mb-step" id="mb-step-02">
          <div class="mb-question" id="mb-q-02"></div>
          <input type="email" class="mb-input" id="mb-input-email" placeholder="Email address" autocomplete="off" />
          <input type="tel" class="mb-input" id="mb-input-whatsapp" placeholder="WhatsApp / Phone number" autocomplete="off" />
