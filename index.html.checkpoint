<!-- ════════════════════════════════════════════
     SECTION 3-5 JAVASCRIPT
     ════════════════════════════════════════════ -->
<script>
(function() {

  /* ── SECTION 3: Staggered card reveal ── */
  const cards = document.querySelectorAll('.feat-card');

  const cardObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const delay = parseInt(entry.target.dataset.revealDelay || 0);
      setTimeout(() => entry.target.classList.add('revealed'), delay);
      cardObserver.unobserve(entry.target);
    });
  }, { threshold: 0.12 });

  cards.forEach(c => cardObserver.observe(c));

  /* ── SECTION 3: 3D Tilt + Spotlight + Animated Border ── */
  cards.forEach(card => {
    /* inject SVG border element */
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('class', 'holo-border-svg');
    svg.setAttribute('preserveAspectRatio', 'none');
    const rect = document.createElementNS('http://www.w3.org/2000/svg', 'rect');
    rect.setAttribute('width', '100%');
    rect.setAttribute('height', '100%');
    svg.appendChild(rect);
    card.insertBefore(svg, card.firstChild);

    card.addEventListener('mousemove', e => {
      const r = card.getBoundingClientRect();
      const x = e.clientX - r.left;
      const y = e.clientY - r.top;
      const cx = r.width  / 2;
      const cy = r.height / 2;
      const rotX =  (y - cy) / 16;
      const rotY = -(x - cx) / 16;
      card.style.setProperty('--mx', x + 'px');
      card.style.setProperty('--my', y + 'px');
      card.style.transform =
        `perspective(900px) rotateX(${rotX}deg) rotateY(${rotY}deg)`;
      card.style.zIndex = '10';
    });

    card.addEventListener('mouseleave', () => {
      card.style.setProperty('--mx', '-999px');
      card.style.setProperty('--my', '-999px');
      card.style.transform =
        'perspective(900px) rotateX(0deg) rotateY(0deg)';
      /* re-trigger border animation on next hover */
      rect.style.animation = 'none';
      void rect.offsetWidth;
      rect.style.animation = '';
    });
  });


  function easeOutExpo(t) {
    return t === 1 ? 1 : 1 - Math.pow(2, -10 * t);
  }

  function countUp(el, target, duration) {
    const start = performance.now();
    function tick(now) {
      const progress = Math.min((now - start) / duration, 1);
      el.textContent = Math.round(easeOutExpo(progress) * target);
      if (progress < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }

  const statBlocks = document.querySelectorAll('.stat-block');

  const statObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (!entry.isIntersecting) return;
      const delay = parseInt(entry.target.dataset.statDelay || 0);
      setTimeout(() => {
        entry.target.classList.add('revealed');
        const el = entry.target.querySelector('.stat-count');
        if (el) {
          const target = parseInt(el.dataset.target);
          const duration = target <= 6 ? 1200 : 1800;
          countUp(el, target, duration);
        }
      }, delay);
      statObserver.unobserve(entry.target);
    });
  }, { threshold: 0.2 });

  statBlocks.forEach(b => statObserver.observe(b));


  /* ── SECTION CONTACT: Request Live Demo button → focus mission brief ── */
  const btnStartBrief = document.getElementById('btn-start-brief');
  if (btnStartBrief) {
    btnStartBrief.addEventListener('click', () => {
      const panel = document.getElementById('mbrief-panel');
      if (panel) {
        if (window.__lenis) {
          window.__lenis.scrollTo(panel, { offset: -80 });
        } else {
          panel.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
        setTimeout(() => {
          const firstInput = document.getElementById('mb-input-operative');
          if (firstInput) firstInput.focus();
          // Flash panel border to signal interaction
          panel.style.transition = 'box-shadow 0.2s';
          panel.style.boxShadow = '0 0 0 1px var(--cyan), 0 0 32px rgba(0,212,255,0.2)';
          setTimeout(() => { panel.style.boxShadow = ''; }, 800);
        }, 520);
      }
    });
  }

})();
</script>


<script>
// ════════════════════════════════════════════════════════════════
// ENHANCEMENT PACK — Scroll + Animations + VR Headset Particles
// ════════════════════════════════════════════════════════════════

// ── SCROLL PROGRESS BAR ──────────────────────────────────────────
(function initScrollProgress() {
  const bar = document.createElement('div');
  bar.id = 'scroll-progress';
  document.body.appendChild(bar);

  function update() {
    const scrolled = window.scrollY;
    const total = document.documentElement.scrollHeight - window.innerHeight;
    bar.style.width = (total > 0 ? Math.min((scrolled / total) * 100, 100) : 0) + '%';
  }
  window.addEventListener('scroll', update, { passive: true });
  update();
})();

// ── SECTION HEADLINE UNDERLINE DRAW on scroll reveal ─────────────
(function initHeadlineLines() {
  const headline = document.querySelector('.s3-headline');
  if (!headline) return;
  const obs = new IntersectionObserver(([e]) => {
    if (e.isIntersecting) {
      headline.classList.add('line-drawn');
      obs.disconnect();
    }
  }, { threshold: 0.4 });
  obs.observe(headline);
})();

// ── CURSOR RING PULSE on click ────────────────────────────────────
(function initCursorPulse() {
  const ring = document.getElementById('cur-ring');
  if (!ring) return;
  document.addEventListener('mousedown', () => {
    ring.classList.remove('pulsing');
    void ring.offsetWidth; // reflow
    ring.classList.add('pulsing');
  });
  ring.addEventListener('animationend', () => ring.classList.remove('pulsing'));
})();

// ── HERO PARALLAX on scroll ───────────────────────────────────────
(function initHeroParallax() {
  const heroLeft = document.getElementById('left');
  const heroRight = document.getElementById('right');
  const section1 = document.getElementById('section-1');
  if (!heroLeft || !section1) return;

  let ticking = false;
  window.addEventListener('scroll', () => {
    if (!ticking) {
      requestAnimationFrame(() => {
        const sy = window.scrollY;
        const h = section1.offsetHeight;
        if (sy < h) {
          const pct = sy / h;
          // Left column drifts up slightly
          heroLeft.style.transform = `translateY(${pct * -28}px)`;
          heroLeft.style.opacity = 1 - pct * 1.6;
          // Right column drifts opposite
          if (heroRight) {
            heroRight.style.transform = `translateY(${pct * -14}px)`;
            heroRight.style.opacity = 1 - pct * 1.2;
          }
        }
        ticking = false;
      });
      ticking = true;
    }
  }, { passive: true });
})();


// ── SUBTLE MODEL BREATHING (Section 2 carousel) ───────────────────
(function initModelBreath() {
  // Adds gentle y-oscillation to the displayed model via rotation
  // This piggybacks on the existing animate() — we just set a global flag
  // The actual breathing is already in the render loop via uTime; this is
  // extra subtle y-rotation pulse via CSS shimmer on the canvas border
  const vp = document.getElementById('model-viewport');
  if (!vp) return;
  let t = 0;
  (function pulse() {
    requestAnimationFrame(pulse);
    t += 0.008;
    const glow = document.getElementById('model-glow');
    if (glow) {
      const s = 1 + Math.sin(t) * 0.04;
      glow.style.transform = `scale(${s})`;
    }
  })();
})();

// ══════════════════════════════════════════════════════════
// NEWTON APPLE — Physics Simulation Card (Section 3)
// ══════════════════════════════════════════════════════════
(function initNewtonApple() {
  const canvas = document.getElementById('physics-apple-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');

  // Match card dimensions
  function resize() {
    const card = canvas.parentElement;
    const w = card.offsetWidth;
    const h = card.offsetHeight;
    canvas.width  = w > 10 ? w : 380;
    canvas.height = h > 10 ? h : 500;
  }
  window.addEventListener('resize', () => { resize(); resetApple(); }, { passive: true });
  // Defer initial resize so card has laid out
  function doAppleInit() { resize(); resetApple(); requestAnimationFrame(() => { resize(); resetApple(); }); }
  if (document.readyState === 'complete') doAppleInit();
  else window.addEventListener('load', doAppleInit, {once: true});

  // ── Color palette matching site
  const C_ORANGE = '#E8511A';
  const C_CYAN   = '#00D4FF';

  // ── Tree branch geometry (top-right quadrant)
  function drawBranch(W, H) {
    const bx = W * 0.62, by = H * 0.08;
    ctx.save();
    // Trunk vertical
    ctx.strokeStyle = 'rgba(232,81,26,0.18)';
    ctx.lineWidth = 1.2;
    ctx.setLineDash([3, 4]);
    ctx.beginPath();
    ctx.moveTo(bx, by);
    ctx.lineTo(bx, by + H * 0.12);
    ctx.stroke();
    // Main branch left
    ctx.beginPath();
    ctx.moveTo(bx, by + H * 0.06);
    ctx.lineTo(bx - W * 0.15, by + H * 0.01);
    ctx.stroke();
    // Sub branch
    ctx.lineWidth = 0.7;
    ctx.strokeStyle = 'rgba(232,81,26,0.1)';
    ctx.beginPath();
    ctx.moveTo(bx - W * 0.08, by + H * 0.035);
    ctx.lineTo(bx - W * 0.14, by - H * 0.025);
    ctx.stroke();
    ctx.setLineDash([]);
    // Glowing node where apple hangs
    const grd = ctx.createRadialGradient(bx - W * 0.15, by + H * 0.01, 0, bx - W * 0.15, by + H * 0.01, 6);
    grd.addColorStop(0, 'rgba(232,81,26,0.6)');
    grd.addColorStop(1, 'transparent');
    ctx.fillStyle = grd;
    ctx.fillRect(bx - W * 0.15 - 9, by + H * 0.01 - 9, 18, 18);
    ctx.restore();
    return { x: bx - W * 0.15, y: by + H * 0.01 };
  }

  // ── Ground line
  function drawGround(W, H) {
    const gy = H * 0.82;
    const grd = ctx.createLinearGradient(0, gy, W, gy);
    grd.addColorStop(0, 'transparent');
    grd.addColorStop(0.3, 'rgba(232,81,26,0.18)');
    grd.addColorStop(0.7, 'rgba(0,212,255,0.12)');
    grd.addColorStop(1, 'transparent');
    ctx.strokeStyle = grd;
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(0, gy); ctx.lineTo(W, gy);
    ctx.stroke();
    return gy;
  }

  // ── Apple (holographic polygon)
  function drawApple(x, y, rot, glitchPhase, alpha) {
    if (alpha <= 0) return;
    ctx.save();
    ctx.globalAlpha = alpha;
    ctx.translate(x, y);
    ctx.rotate(rot);

    const r = 22;

    // Glitch: RGB split offset
    const gx = glitchPhase > 0 ? Math.sin(glitchPhase * 18) * 3.5 : 0;
    const gy2 = glitchPhase > 0 ? Math.cos(glitchPhase * 14) * 2 : 0;

    // Red channel ghost
    if (glitchPhase > 0) {
      ctx.globalAlpha = alpha * 0.5;
      ctx.strokeStyle = 'rgba(255,60,60,0.65)';
      ctx.lineWidth = 1;
      ctx.beginPath();
      for (let i = 0; i <= 6; i++) {
        const a = (i / 6) * Math.PI * 2;
        const px = Math.cos(a) * r * (1 + Math.sin(a) * 0.2) + gx;
        const py = Math.sin(a) * r * 0.88 - gy2;
        i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
      }
      ctx.closePath();
      ctx.stroke();
      ctx.globalAlpha = alpha;
    }

    // Main apple outline — holographic orange
    ctx.strokeStyle = C_ORANGE;
    ctx.lineWidth = 1.2;
    ctx.shadowColor = C_ORANGE;
    ctx.shadowBlur = 6;
    ctx.beginPath();
    for (let i = 0; i <= 7; i++) {
      const a = (i / 7) * Math.PI * 2;
      const rx = r + Math.sin(a * 2.5) * 1.8;
      const ry = r * 0.88;
      const px = Math.cos(a) * rx;
      const py = Math.sin(a) * ry;
      i === 0 ? ctx.moveTo(px, py) : ctx.lineTo(px, py);
    }
    ctx.closePath();
    ctx.stroke();
    ctx.shadowBlur = 0;

    // Inner cyan wireframe cross
    ctx.strokeStyle = `rgba(0,212,255,0.4)`;
    ctx.lineWidth = 0.6;
    ctx.beginPath();
    ctx.moveTo(-r * 0.6, 0); ctx.lineTo(r * 0.6, 0);
    ctx.moveTo(0, -r * 0.6); ctx.lineTo(0, r * 0.6);
    ctx.stroke();

    // Stem
    ctx.strokeStyle = 'rgba(232,81,26,0.5)';
    ctx.lineWidth = 1;
    ctx.beginPath();
    ctx.moveTo(1, -r); ctx.lineTo(1, -r - 5);
    ctx.stroke();

    ctx.restore();
  }

  // ── Absorption particles (sink into ground)
  let absorptionParticles = [];
  function spawnAbsorption(x, groundY) {
    absorptionParticles = [];
    for (let i = 0; i < 22; i++) {
      absorptionParticles.push({
        x: x + (Math.random() - 0.5) * 22,
        y: groundY,
        vx: (Math.random() - 0.5) * 1.8,
        vy: Math.random() * 1.2 + 0.3,
        life: 1.0,
        decay: 0.025 + Math.random() * 0.018,
        r: Math.random() * 2.2 + 0.6,
        col: Math.random() > 0.5 ? C_ORANGE : C_CYAN,
      });
    }
  }

  function updateAbsorptionParticles() {
    absorptionParticles.forEach(p => {
      p.x += p.vx;
      p.y += p.vy * 0.5; // drift down slowly (sinking into ground)
      p.vy *= 0.94;
      p.life -= p.decay;
    });
    absorptionParticles = absorptionParticles.filter(p => p.life > 0);
  }

  function drawAbsorptionParticles() {
    absorptionParticles.forEach(p => {
      ctx.globalAlpha = p.life * 0.7;
      ctx.fillStyle = p.col;
      ctx.beginPath();
      ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
      ctx.fill();
    });
    ctx.globalAlpha = 1;
  }

  // ── State machine
  // STATES: 'falling', 'impact', 'absorbing', 'waiting', 'reappearing'
  let state = 'falling';
  // Word collision for fade-through effect
  let wordRects = [];
  function refreshWordRects() {
    wordRects = [];
    const card = canvas.parentElement;
    if (!card) return;
    const cardRect = card.getBoundingClientRect();
    const els = card.querySelectorAll('.card-title, .card-desc, .card-tag, .card-index');
    els.forEach(el => {
      const r = el.getBoundingClientRect();
      if (r.width > 0 && r.height > 0) {
        wordRects.push({ x: r.left - cardRect.left, y: r.top - cardRect.top, w: r.width, h: r.height });
      }
    });
  }
  function appleOverlapsText(ax, ay, radius) {
    for (const {x,y,w,h} of wordRects) {
      const cx = Math.max(x, Math.min(ax, x+w));
      const cy = Math.max(y, Math.min(ay, y+h));
      const dx = ax-cx, dy = ay-cy;
      if (dx*dx + dy*dy < radius*radius) return true;
    }
    return false;
  }
  refreshWordRects();
  setInterval(refreshWordRects, 600);

  let appleX, appleY, appleVY, appleRot, appleRotV;
  let stateTimer = 0;
  let glitchPhase = 0;
  let appleAlpha = 1;
  let hangX, hangY, groundY;
  let waitDuration = 0;
  let isVisible = false;

  function resetApple() {
    const W = canvas.width, H = canvas.height;
    hangX = W * 0.62 - W * 0.15;
    hangY = H * 0.08 + H * 0.01;
    groundY = H * 0.82;
    appleX = hangX;
    appleY = hangY + 16;
    appleVY = 0;
    appleRot = 0;
    appleRotV = (Math.random() - 0.5) * 0.06;
    state = 'falling';
    stateTimer = 0;
    glitchPhase = 0;
    appleAlpha = 1;
    absorptionParticles = [];
  }

  // Init
  resetApple();

  // Only animate when card is visible
  const obs = new IntersectionObserver(([e]) => {
    isVisible = e.isIntersecting;
  }, { threshold: 0.1 });
  obs.observe(canvas.parentElement);

  let lastTs = null;
  function loop(ts) {
    requestAnimationFrame(loop);
    if (!isVisible) return;
    const dt = lastTs ? Math.min((ts - lastTs) * 0.001, 0.05) : 0.016;
    lastTs = ts;
    stateTimer += dt;

    const W = canvas.width, H = canvas.height;
    ctx.clearRect(0, 0, W, H);

    // Draw branch and ground every frame
    const hang = drawBranch(W, H);
    hangX = hang.x; hangY = hang.y;
    groundY = drawGround(W, H);

    // ── STATE MACHINE ──
    if (state === 'falling') {
      // Brief hang at top (0.6s) then drop
      if (stateTimer > 0.6) {
        appleVY += 280 * dt; // gravity px/s²
        appleY += appleVY * dt;
        appleRot += appleRotV;
      } else {
        // Subtle swing before drop
        appleX = hangX + Math.sin(stateTimer * 5) * 1.5;
      }
      const _hit = appleOverlapsText(appleX, appleY, 12);
      if (_hit) appleAlpha = Math.max(0.06, appleAlpha - dt * 6);
      else appleAlpha = Math.min(1.0, appleAlpha + dt * 4);
      drawApple(appleX, appleY, appleRot, 0, appleAlpha);

      if (appleY >= groundY) {
        appleY = groundY;
        state = 'impact';
        stateTimer = 0;
        glitchPhase = 1.0;
        spawnAbsorption(appleX, groundY);
      }

    } else if (state === 'impact') {
      // Glitch burst for 0.5s
      glitchPhase = Math.max(0, 1.0 - stateTimer / 0.5);
      appleAlpha = 1;
      drawApple(appleX, appleY, appleRot, glitchPhase, appleAlpha);
      updateAbsorptionParticles();
      drawAbsorptionParticles();

      if (stateTimer > 0.5) {
        state = 'absorbing';
        stateTimer = 0;
      }

    } else if (state === 'absorbing') {
      // Apple fades / sinks into ground over 0.7s
      appleAlpha = Math.max(0, 1 - stateTimer / 0.7);
      const sinkY = groundY + stateTimer * 18;
      drawApple(appleX, sinkY, appleRot, 0, appleAlpha);
      updateAbsorptionParticles();
      drawAbsorptionParticles();

      // Absorption shockwave ring
      const ringR = stateTimer * 38;
      if (ringR < 55) {
        ctx.globalAlpha = (1 - stateTimer / 0.7) * 0.3;
        ctx.strokeStyle = C_CYAN;
        ctx.lineWidth = 1;
        ctx.beginPath();
        ctx.ellipse(appleX, groundY, ringR, ringR * 0.22, 0, 0, Math.PI * 2);
        ctx.stroke();
        ctx.globalAlpha = 1;
      }

      if (stateTimer > 0.7) {
        state = 'waiting';
        stateTimer = 0;
        waitDuration = 1.1 + Math.random() * 0.5;
        absorptionParticles = [];
      }

    } else if (state === 'waiting') {
      // Empty pause — let ground line breathe
      if (stateTimer > waitDuration) {
        state = 'reappearing';
        stateTimer = 0;
        appleX = hangX;
        appleY = hangY + 16;
        appleVY = 0;
        appleRot = 0;
        appleRotV = (Math.random() - 0.5) * 0.06;
      }

    } else if (state === 'reappearing') {
      // Glitch-in from branch position over 0.4s
      const t = Math.min(stateTimer / 0.4, 1);
      appleAlpha = t;
      glitchPhase = (1 - t) * 0.8;
      drawApple(appleX, appleY, 0, glitchPhase, appleAlpha);
      if (t >= 1) {
        state = 'falling';
        stateTimer = 0;
        glitchPhase = 0;
        appleAlpha = 1;
      }
    }
  }

  requestAnimationFrame(loop);
})();

// ══════════════════════════════════════════════════════════
// SECTION 3 — WARP GRID CANVAS BACKGROUND
// ══════════════════════════════════════════════════════════
(function initS3Warp() {
  const canvas = document.getElementById('s3-warp-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let W = 0, H = 0, animId = null, isVisible = false;

  function resize() {
    const sec = document.getElementById('section-3');
    W = canvas.width  = sec ? sec.offsetWidth  : window.innerWidth;
    H = canvas.height = sec ? sec.offsetHeight : window.innerHeight;
  }

  const COLS = 18, ROWS = 12;

  function draw(ts) {
    animId = requestAnimationFrame(draw);
    ctx.clearRect(0, 0, W, H);
    const t = (ts || 0) * 0.0006;
    const cw = W / COLS, ch = H / ROWS;

    // Draw warped grid lines
    ctx.lineWidth = 0.7;

    // Vertical warped lines
    for (let c = 0; c <= COLS; c++) {
      ctx.beginPath();
      for (let r = 0; r <= ROWS; r++) {
        const bx = c * cw;
        const by = r * ch;
        // Warp: sine displacement based on row + time
        const warpAmp = 6;
        const wx = bx + Math.sin(r * 0.55 + t * 1.3 + c * 0.2) * warpAmp;
        const wy = by + Math.cos(c * 0.4  + t * 0.9 + r * 0.15) * warpAmp * 0.5;
        // Color shift: cyan on left columns, violet on right
        const hue = c / COLS;
        const alpha = 0.04 + Math.abs(Math.sin(c * 0.4 + t)) * 0.025;
        const col = hue < 0.5
          ? `rgba(0,212,255,${alpha})`
          : `rgba(123,47,255,${alpha * 0.85})`;
        ctx.strokeStyle = col;
        r === 0 ? ctx.moveTo(wx, wy) : ctx.lineTo(wx, wy);
      }
      ctx.stroke();
    }

    // Horizontal warped lines
    for (let r = 0; r <= ROWS; r++) {
      ctx.beginPath();
      for (let c = 0; c <= COLS; c++) {
        const bx = c * cw;
        const by = r * ch;
        const warpAmp = 6;
        const wx = bx + Math.sin(r * 0.55 + t * 1.3 + c * 0.2) * warpAmp;
        const wy = by + Math.cos(c * 0.4  + t * 0.9 + r * 0.15) * warpAmp * 0.5;
        const alpha = 0.03 + Math.abs(Math.sin(r * 0.5 + t * 0.7)) * 0.02;
        ctx.strokeStyle = `rgba(0,212,255,${alpha})`;
        c === 0 ? ctx.moveTo(wx, wy) : ctx.lineTo(wx, wy);
      }
      ctx.stroke();
    }
  }

  const obs = new IntersectionObserver(([e]) => {
    isVisible = e.isIntersecting;
    if (isVisible && !animId) draw(performance.now());
    else if (!isVisible && animId) { cancelAnimationFrame(animId); animId = null; }
  }, { threshold: 0.05 });
  const sec3 = document.getElementById('section-3');
  if (sec3) obs.observe(sec3);

  window.addEventListener('resize', () => {
    if (animId) { cancelAnimationFrame(animId); animId = null; }
    resize();
    if (isVisible) draw(performance.now());
  }, { passive: true });

  resize();
})();

// ══════════════════════════════════════════════════════════
// SECTION 4 — TEAM ORBIT
// ══════════════════════════════════════════════════════════
(function initS4Team() {
  // Header reveal
  const header = document.getElementById('s4-header');
  if (header) {
    const ho = new IntersectionObserver(([e]) => {
      if (e.isIntersecting) { header.classList.add('revealed'); ho.disconnect(); }
    }, { threshold: 0.1 });
    ho.observe(header);
  }

  // ── Orbit widget ──
  const orbit = document.getElementById('tm-orbit');
  if (!orbit) return;

  const trackOuter = document.getElementById('tm-orbit-track-outer');
  const trackInner = document.getElementById('tm-orbit-track');
  const leadNode    = document.getElementById('tm-node-lead');
  const orbitNodes  = Array.from(orbit.querySelectorAll('.tm-node--orbit'));
  const innerNodes  = orbitNodes.filter((n) => n.dataset.ring !== 'outer');
  const outerNodes  = orbitNodes.filter((n) => n.dataset.ring === 'outer');
  const allNodes    = [leadNode, ...orbitNodes].filter(Boolean);

  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // Degrees of orbit rotation per pixel scrolled. Scrolling down turns the
  // ring clockwise, scrolling up turns it back anticlockwise. Tune to taste.
  const ROTATE_SPEED = 0.14;

  // The lead circle starts oversized (one big globe) and settles down to
  // exactly match the orbit avatars' final size once fully unfolded, so
  // every node ends up the same size.
  const LEAD_SCALE_BIG = 1.4;
  const ORBIT_SIZE = 240; // px, must match .tm-avatar width/height
  const LEAD_SIZE   = 340;  // px, must match .tm-node--lead .tm-avatar width/height
  const LEAD_SCALE_END = ORBIT_SIZE / LEAD_SIZE;

  // When two orbit circles swing close enough to overlap, fade them out
  // further (on top of their normal reveal-based opacity) so the overlap
  // never reads as a muddy double-exposure.
  const OVERLAP_FADE_STRENGTH = 0.65;

  let cx = 0, cy = 0;
  let rxIn = 0, ryIn = 0, rxOut = 0, ryOut = 0;
  let targetRotation  = 0;   // where the ring should end up, driven by scroll
  let currentRotation = 0;   // what's actually rendered, eases toward the target
  let targetReveal    = reduceMotion ? 1 : 0; // 0 = just the big lead globe, 1 = fully unfolded
  let currentReveal   = targetReveal;
  let lastScrollY = window.scrollY;
  let inView = false;
  let animating = false;

  // Lower EASE = more trailing "momentum" glide, higher = snappier catch-up.
  const EASE = 0.08;
  const SETTLE_EPSILON = 0.01; // deg — close enough to stop the render loop
  const REVEAL_EPSILON = 0.001;

  function clamp01(v) { return v < 0 ? 0 : v > 1 ? 1 : v; }

  function measure() {
    const rect = orbit.getBoundingClientRect();
    cx = rect.width / 2;
    cy = rect.height / 2;
    // Solved numerically against a fixed height budget (see .tm-orbit height
    // above) so the whole assembly stays comfortably inside the viewport
    // instead of turning into a very long scroll-through. Within that
    // budget this clears lead-vs-inner-ring and ring-vs-ring almost
    // entirely; the one remaining close pass (inner vs. outer ring, ~35-45px
    // at worst) is brief and handled by the overlap fade below. Every value
    // also keeps avatars a safe margin inside the container edges so
    // nothing gets clipped by #section-4's overflow:hidden.
    rxIn  = Math.min(rect.width  * 0.212, 250);
    ryIn  = Math.min(rect.height * 0.191, 210);
    rxOut = Math.min(rect.width  * 0.381, 450);
    ryOut = Math.min(rect.height * 0.373, 410);
    if (trackOuter) {
      trackOuter.style.width  = (rxOut * 2) + 'px';
      trackOuter.style.height = (ryOut * 2) + 'px';
      trackOuter.style.marginLeft = (-rxOut) + 'px';
      trackOuter.style.marginTop  = (-ryOut) + 'px';
    }
    if (trackInner) {
      trackInner.style.width  = (rxIn * 2) + 'px';
      trackInner.style.height = (ryIn * 2) + 'px';
      trackInner.style.marginLeft = (-rxIn) + 'px';
      trackInner.style.marginTop  = (-ryIn) + 'px';
    }
  }

  // How far the section has scrolled into its "unfold" window — 0 the
  // moment it starts entering the viewport, 1 once it's been scrolled up
  // to sit comfortably in view. Scrolling back up runs this in reverse.
  function measureRevealTarget() {
    if (reduceMotion) return 1;
    const rect = orbit.getBoundingClientRect();
    const vh = window.innerHeight;
    const start = vh * 0.92;
    const end   = vh * 0.30;
    return clamp01((start - rect.top) / (start - end));
  }

  function place(node, rx, ry, nodeReveal) {
    const base  = parseFloat(node.dataset.angle) || 0;
    const angle = (base + currentRotation) * (Math.PI / 180);
    const r = clamp01(nodeReveal);
    const x = cx + rx * r * Math.cos(angle);
    const y = cy + ry * r * Math.sin(angle);
    // depth cue: nodes toward the front (lower half of the ellipse) sit
    // slightly larger and above the ones toward the back
    const depth = (Math.sin(angle) + 1) / 2; // 0 = back, 1 = front
    const scale = (0.86 + depth * 0.18) * r;
    node.style.transform = `translate(${x}px, ${y}px) scale(${scale.toFixed(3)})`;
    node.style.zIndex = String(6 + Math.round(depth * 3));
    // opacity is finalized in applyOverlapFade() once every node's
    // position is known, so hand back the state instead of setting it here
    return { node, x, y, radius: (ORBIT_SIZE / 2) * scale, baseOpacity: r };
  }

  // Pairwise-checks every orbit node against every other one; wherever two
  // circles' footprints overlap, both get faded further, proportional to
  // how much they overlap (fully concentric = maximum extra fade). Also
  // checks each orbit node against the lead circle — the lead stays fully
  // opaque (it's the fixed anchor) but a node swinging in close behind it
  // ducks out of the way instead of crashing through it unfaded.
  function applyOverlapFade(states, lead) {
    const fade = new Array(states.length).fill(0);
    for (let i = 0; i < states.length; i++) {
      for (let j = i + 1; j < states.length; j++) {
        const a = states[i], b = states[j];
        const sumR = a.radius + b.radius;
        if (sumR <= 0) continue;
        const dist = Math.hypot(a.x - b.x, a.y - b.y);
        if (dist >= sumR) continue;
        const overlap = clamp01((sumR - dist) / sumR);
        if (overlap > fade[i]) fade[i] = overlap;
        if (overlap > fade[j]) fade[j] = overlap;
      }
      if (lead) {
        const sumR = states[i].radius + lead.radius;
        if (sumR > 0) {
          const dist = Math.hypot(states[i].x - lead.x, states[i].y - lead.y);
          if (dist < sumR) {
            const overlap = clamp01((sumR - dist) / sumR);
            if (overlap > fade[i]) fade[i] = overlap;
          }
        }
      }
    }
    states.forEach((s, i) => {
      const opacity = clamp01(s.baseOpacity * (1 - fade[i] * OVERLAP_FADE_STRENGTH));
      s.node.style.opacity = opacity.toFixed(3);
    });
  }

  function layout() {
    let leadState = null;
    if (leadNode) {
      const leadScale = LEAD_SCALE_BIG - (LEAD_SCALE_BIG - LEAD_SCALE_END) * currentReveal;
      leadNode.style.transform = `translate(${cx}px, ${cy}px) scale(${leadScale.toFixed(3)})`;
      leadState = { x: cx, y: cy, radius: (LEAD_SIZE / 2) * leadScale };
    }
    // Inner ring unfolds across the first ~55% of the reveal, outer ring
    // across the back half — with a little overlap so the two rings read
    // as one continuous motion rather than two separate steps.
    const states = [];
    innerNodes.forEach((n) => states.push(place(n, rxIn,  ryIn,  currentReveal / 0.55)));
    outerNodes.forEach((n) => states.push(place(n, rxOut, ryOut, (currentReveal - 0.45) / 0.55)));
    applyOverlapFade(states, leadState);
  }

  // Continuously eases rotation + reveal toward their targets, then stops
  // itself once both settle — so idle time costs nothing, but any new
  // scroll input restarts a smooth glide rather than an instant jump.
  function tick() {
    const dR = targetRotation - currentRotation;
    const dV = targetReveal - currentReveal;
    if (Math.abs(dR) < SETTLE_EPSILON && Math.abs(dV) < REVEAL_EPSILON) {
      currentRotation = targetRotation;
      currentReveal   = targetReveal;
      layout();
      animating = false;
      return;
    }
    currentRotation += dR * EASE;
    currentReveal   += dV * EASE;
    layout();
    if (!inView) { animating = false; return; }
    requestAnimationFrame(tick);
  }

  function requestTick() {
    if (!animating) { animating = true; requestAnimationFrame(tick); }
  }

  function onScroll() {
    const y = window.scrollY;
    const delta = y - lastScrollY;
    lastScrollY = y;
    if (!inView) return;
    targetReveal = measureRevealTarget();
    if (!reduceMotion) targetRotation += delta * ROTATE_SPEED;
    requestTick();
  }

  measure();
  targetReveal  = measureRevealTarget();
  currentReveal = targetReveal;
  layout();

  window.addEventListener('scroll', onScroll, { passive: true });
  window.addEventListener('resize', () => {
    measure();
    targetReveal = measureRevealTarget();
    layout();
  });

  // Spend rotation/reveal cycles a little before and after the orbit is
  // strictly on-screen, so the unfold is already animating as it arrives.
  const orbitObserver = new IntersectionObserver(([entry]) => {
    inView = entry.isIntersecting;
    if (inView) {
      orbit.classList.add('revealed');
      lastScrollY = window.scrollY;
      targetReveal = measureRevealTarget();
      requestTick();
    }
  }, { threshold: 0, rootMargin: '35% 0px 35% 0px' });
  orbitObserver.observe(orbit);

  // Tap/click a node to toggle its social links (mirrors :hover for touch)
  allNodes.forEach((node) => {
    node.addEventListener('click', (e) => {
      if (e.target.closest('.tm-social')) return; // let the link navigate
      const wasActive = node.classList.contains('is-active');
      allNodes.forEach(n => n.classList.remove('is-active'));
      if (!wasActive) node.classList.add('is-active');
    });
  });
  document.addEventListener('click', (e) => {
    if (!orbit.contains(e.target)) allNodes.forEach(n => n.classList.remove('is-active'));
  });

  // "Open Seat" nodes scroll smoothly to the contact section
  orbit.querySelectorAll('.tm-social--apply').forEach((link) => {
    link.addEventListener('click', (e) => {
      const target = document.getElementById(link.dataset.scrollTarget || '');
      if (!target) return;
      e.preventDefault();
      if (window.__lenis) window.__lenis.scrollTo(target, { offset: 0 });
      else target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
  });
})();

// ══════════════════════════════════════════════════════════
// SECTION 2 — FLOATING DEPTH FIELD (background particles)
// ══════════════════════════════════════════════════════════
(function initS2Depth() {
  const canvas = document.getElementById('s2-depth-canvas');
  if (!canvas) return;
  const ctx = canvas.getContext('2d');
  let W = 0, H = 0;
  let pts = [], animId = null, isVisible = false;

  function resize() {
    const sec = document.getElementById('section-2');
    W = canvas.width  = sec ? sec.offsetWidth  : window.innerWidth;
    H = canvas.height = sec ? sec.offsetHeight : window.innerHeight;
    buildPts();
  }

  function buildPts() {
    pts = [];
    for (let i = 0; i < 38; i++) {
      pts.push({
        x: Math.random() * W,
        y: Math.random() * H,
        z: Math.random(),            // 0=far, 1=near
        vx: (Math.random() - 0.5) * 0.12,
        vy: (Math.random() - 0.5) * 0.08,
        phase: Math.random() * Math.PI * 2,
        col: Math.random() > 0.6 ? [0,212,255] : Math.random() > 0.5 ? [232,81,26] : [123,47,255],
      });
    }
  }

  function draw(ts) {
    animId = requestAnimationFrame(draw);
    ctx.clearRect(0, 0, W, H);
    const now = (ts || 0) * 0.001;

    pts.forEach(p => {
      // Depth-based speed (near pts move faster)
      p.x += p.vx * (0.3 + p.z * 0.7);
      p.y += p.vy * (0.3 + p.z * 0.7);
      if (p.x < 0) p.x = W;
      if (p.x > W) p.x = 0;
      if (p.y < 0) p.y = H;
      if (p.y > H) p.y = 0;

      const alpha = (0.04 + p.z * 0.12) * (0.7 + Math.sin(now * 1.4 + p.phase) * 0.3);
      const r = 0.5 + p.z * 2.2;

      ctx.beginPath();
      ctx.arc(p.x, p.y, r, 0, Math.PI * 2);
      ctx.fillStyle = `rgba(${p.col[0]},${p.col[1]},${p.col[2]},${alpha})`;
      ctx.fill();
    });
  }

  const obs = new IntersectionObserver(([e]) => {
    isVisible = e.isIntersecting;
    if (isVisible && !animId) draw(performance.now());
    else if (!isVisible && animId) { cancelAnimationFrame(animId); animId = null; }
  }, { threshold: 0.05 });
  const sec2 = document.getElementById('section-2');
  if (sec2) obs.observe(sec2);

  window.addEventListener('resize', () => {
    if (animId) { cancelAnimationFrame(animId); animId = null; }
    resize();
    if (isVisible) draw(performance.now());
  }, { passive: true });

  resize();
})();

// ── HERO WIREFRAME BLOOM PULSE ─────────────────────────────────────
(function initHeroBloom() {
  const cv = document.getElementById('three-canvas');
  if (!cv) return;
  let t = 0;
  (function pulse() {
    requestAnimationFrame(pulse);
    t += 0.012;
    const intensity = 0.22 + Math.sin(t) * 0.12;
    cv.style.filter = `drop-shadow(0 0 ${(intensity * 28).toFixed(1)}px rgba(0,212,255,${intensity.toFixed(2)}))`;
  })();
})();



// ══════════════════════════════════════════════════════════════
// INTRO SCREEN — SVG PATH PAGE TRANSITION (VERTICAL)
// Inspired by Codrops Sketch 021
// ══════════════════════════════════════════════════════════════
(function initIntroTransition() {
  const screen    = document.getElementById('intro-screen');
  const pathEl    = document.getElementById('intro-path');
  const fillEl    = document.getElementById('intro-progress-fill');
  const pctEl     = document.getElementById('intro-pct');
  const enterBtn  = document.getElementById('intro-enter-btn');
  const skipBtn   = document.getElementById('intro-skip');
  const tsEl      = document.getElementById('intro-ts');
  const bootLines = [
    document.getElementById('bl-1'),
    document.getElementById('bl-2'),
    document.getElementById('bl-3'),
  ];

  if (!screen || !pathEl) return;

  // Disable browser scroll restoration so it can't jump to a saved position
  if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
  // Force scroll to top before locking — hero must be what's underneath
  window.scrollTo(0, 0);

  // Prevent body scroll while intro is active
  document.body.style.overflow = 'hidden';

  // ── Timestamp ticker ──
  const startTs = Date.now();
  const tsTick  = setInterval(() => {
    const ms = Date.now() - startTs;
    const s  = Math.floor(ms / 1000) % 60;
    const m  = Math.floor(ms / 60000) % 60;
    const h  = Math.floor(ms / 3600000);
    tsEl.textContent = [h, m, s].map(n => String(n).padStart(2,'0')).join(':');
  }, 250);

  // ── Boot lines sequence ──
  bootLines.forEach((el, i) => {
    setTimeout(() => {
      bootLines.forEach((b, j) => {
        b.classList.toggle('active', j === i);
        b.classList.toggle('done',   j < i);
      });
    }, 400 + i * 480);
  });

  // ── Progress bar ──
  const TOTAL_MS = 2600;
  const start    = performance.now();
  let   pct      = 0;
  let   rafId;

  function tickProgress(now) {
    pct = Math.min(100, ((now - start) / TOTAL_MS) * 100);
    fillEl.style.width = pct + '%';
    pctEl.textContent  = Math.floor(pct) + '%';

    if (pct < 100) {
      rafId = requestAnimationFrame(tickProgress);
    } else {
      // Progress complete — show ENTER button
      pctEl.textContent = '100%';
      enterBtn.classList.add('ready');

      // Auto-fire after a short grace window
      autoTimer = setTimeout(playTransition, 1400);
    }
  }
  rafId = requestAnimationFrame(tickProgress);

  let autoTimer = null;
  let fired     = false;

  // ── SVG Path builder ──
  // viewBox: 0 0 1440 120
  // amp=0: flat rectangle; amp>0: wavy cubic bezier curtain edge
  function buildPath(amp) {
    const W = 1440, H = 120;
    if (amp <= 0) return `M 0,0 H ${W} V ${H} H 0 Z`;
    // Organic wave: two cubic bezier humps, one up one down
    return (
      `M 0,0 H ${W}` +
      // Right anchor down-curve, left anchor up-curve
      ` V ${H + amp * 0.55}` +
      ` C ${W * 0.72},${H - amp} ${W * 0.28},${H + amp} 0,${H - amp * 0.45}` +
      ` Z`
    );
  }

  // ── Main transition ──
  function playTransition() {
    if (fired) return;
    fired = true;

    clearTimeout(autoTimer);
    cancelAnimationFrame(rafId);
    clearInterval(tsTick);

    window.scrollTo(0, 0);

    // ── CSS-only fallback (runs if GSAP CDN failed to load) ──
    if (typeof gsap === 'undefined') {
      screen.style.transition = 'opacity 0.55s ease, transform 0.65s cubic-bezier(0.4,0,0.2,1)';
      screen.style.opacity    = '0';
      screen.style.transform  = 'translateY(-100%)';
      setTimeout(() => {
        window.scrollTo(0, 0);
        screen.remove();
        document.body.style.overflow = '';
        initLenis();
      }, 680);
      return;
    }

    const state = { amp: 0 };

    // Step 1: fade out content
    // Step 2: bulge SVG wave
    // Step 3: slide entire screen up, wave flattens as it exits
    try {
    const tl = gsap.timeline({
      onComplete: () => {
        window.scrollTo(0, 0);
        screen.remove();
        document.body.style.overflow = '';
        initLenis();
      }
    });

    tl
      // Fade out branding
      .to('#intro-content', {
        opacity: 0,
        y: -18,
        duration: 0.38,
        ease: 'power2.in'
      })

      // Form the wave (curtain tenses before lift)
      .to(state, {
        amp: 88,
        duration: 0.42,
        ease: 'power2.in',
        onUpdate: () => pathEl.setAttribute('d', buildPath(state.amp))
      }, '-=0.18')

      // Lift the entire curtain upward
      .to(screen, {
        y: '-100%',
        duration: 0.88,
        ease: 'power3.inOut'
      }, '-=0.12')

      // Wave flattens as it exits (trailing edge goes smooth)
      .to(state, {
        amp: 0,
        duration: 0.52,
        ease: 'power2.out',
        onUpdate: () => pathEl.setAttribute('d', buildPath(state.amp))
      }, '<+=0.18');
    } catch(e) {
      // GSAP threw — bail out with instant CSS dismiss
      window.scrollTo(0, 0);
      screen.remove();
      document.body.style.overflow = '';
      initLenis();
    }
  }

  // ── Button / skip hooks ──
  enterBtn.addEventListener('click', playTransition);
  skipBtn.addEventListener('click',  playTransition);

  // ── Keyboard: any key after load fires transition ──
  window.addEventListener('keydown', function onKey(e) {
    if (fired) return;
    if (e.key === 'Enter' || e.key === ' ' || e.key === 'Escape') {
      window.removeEventListener('keydown', onKey);
      playTransition();
    }
  });

  // ══════════════════════════════════════════════════════
  // LENIS — init after intro clears, never before
  // Adds smooth scroll + scroll-driven scale/dim on
  // section-1 as section-2 slides over the top of it.
  // ══════════════════════════════════════════════════════
  function initLenis() {
    if (typeof Lenis === 'undefined') return;

    const lenis = new Lenis({
      duration: 1.2,
      easing: t => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
      smoothWheel: true,
      wheelMultiplier: 0.88,
    });

    // ── RAF loop ──
    function raf(time) { lenis.raf(time); requestAnimationFrame(raf); }
    requestAnimationFrame(raf);

    // ── Expose globally so scrollTo calls below can use it ──
    window.__lenis = lenis;

    // ── Section refs ──
    const s1 = document.getElementById('section-1');
    const s2 = document.getElementById('section-2');
    const s3 = document.getElementById('section-3');
    const s4 = document.getElementById('section-4');
    const sc = document.getElementById('section-contact');

    // ── Scroll-driven transform: scale+dim sections as
    //    the next section slides over them ──
    lenis.on('scroll', ({ scroll }) => {
      if (!s1) return;

      // section-1 scales + dims as section-2 advances over it
      const s1H = s1.offsetHeight;
      const p1 = Math.max(0, Math.min(1, scroll / s1H));
      s1.style.transform = `scale(${(1 - p1 * 0.07).toFixed(4)})`;
      s1.style.filter    = `brightness(${(1 - p1 * 0.40).toFixed(3)})`;

      // section-2 scales + dims as section-3 comes in
      if (s2 && s3) {
        const s2Top = s1H;
        const s2H   = s2.offsetHeight;
        const p2    = Math.max(0, Math.min(1, (scroll - s2Top) / s2H));
        s2.style.transform = `scale(${(1 - p2 * 0.05).toFixed(4)})`;
        s2.style.filter    = `brightness(${(1 - p2 * 0.35).toFixed(3)})`;
      }

      // section-3 scales + dims as section-4 comes in
      if (s3 && s4) {
        const s3Top = s1.offsetHeight + (s2 ? s2.offsetHeight : 0);
        const s3H   = s3.offsetHeight;
        const p3    = Math.max(0, Math.min(1, (scroll - s3Top) / s3H));
        s3.style.transform = `scale(${(1 - p3 * 0.05).toFixed(4)})`;
        s3.style.filter    = `brightness(${(1 - p3 * 0.30).toFixed(3)})`;
      }

      // section-4 scales + dims as contact slides in
      if (s4 && sc) {
        const s4Top = s1.offsetHeight + (s2 ? s2.offsetHeight : 0) + (s3 ? s3.offsetHeight : 0);
        const s4H   = s4.offsetHeight;
        const p4    = Math.max(0, Math.min(1, (scroll - s4Top) / s4H));
        s4.style.transform = `scale(${(1 - p4 * 0.05).toFixed(4)})`;
        s4.style.filter    = `brightness(${(1 - p4 * 0.28).toFixed(3)})`;
      }
    });
  }

})();


// ══════════════════════════════════════════════════════════════
// SECTION CONTACT — CYCLING WORDS + REVEAL
// ══════════════════════════════════════════════════════════════
(function initContactSection() {
  const inner = document.getElementById('sc-inner');
  if (!inner) return;

  // ── Reveal on scroll ──
  const revealObs = new IntersectionObserver(([e]) => {
    if (e.isIntersecting) {
      inner.classList.add('revealed');
      const hbg = document.getElementById('headset-bg');
      if (hbg) setTimeout(() => hbg.classList.add('revealed'), 220);
      revealObs.disconnect();
    }
  }, { threshold: 0.15 });
  const secC = document.getElementById('section-contact');
  if (secC) revealObs.observe(secC);

  // ── Cycling words ──
  const words = inner.querySelectorAll('.sc-cycle-word');
  let current = 0;

  // Show first immediately
  words[0].classList.add('active');

  setInterval(() => {
    const prev = current;
    current = (current + 1) % words.length;

    words[prev].classList.remove('active');
    words[prev].classList.add('exit');
    setTimeout(() => words[prev].classList.remove('exit'), 350);

    words[current].classList.add('active');
  }, 2200);

  // ── Form: prevent default + flash confirmation ──
  const submitBtn = inner.querySelector('.sc-form-submit');
  if (submitBtn) {
    submitBtn.addEventListener('click', () => {
      submitBtn.textContent = 'SIGNAL RECEIVED ✓';
      submitBtn.style.color = '#4DFF91';
      submitBtn.style.borderColor = 'rgba(77,255,145,0.4)';
      setTimeout(() => {
        submitBtn.textContent = 'TRANSMIT MESSAGE';
        submitBtn.style.color = '';
        submitBtn.style.borderColor = '';
      }, 2800);
    });
  }
})();

(function initSectionTracker() {
  const sections = ['section-1','section-2','section-3','section-4','section-contact','section-5']
    .map(id => document.getElementById(id)).filter(Boolean);
  const navItems = document.querySelectorAll('.ni');

  const sectionNavMap = { 'section-2': 0, 'section-3': 1, 'section-4': 2, 'section-contact': 3, 'section-5': 4 };

  const obs = new IntersectionObserver((entries) => {
    entries.forEach(e => {
      if (e.isIntersecting) {
        const idx = sectionNavMap[e.target.id];
        if (idx !== undefined) {
          navItems.forEach((n, i) => {
            n.style.color = i === idx
              ? 'rgba(238,242,255,0.85)'
              : 'rgba(238,242,255,0.22)';
          });
        }
      }
    });
  }, { threshold: 0.35 });

  sections.forEach(s => obs.observe(s));
})();

// ══════════════════════════════════════════════════════════════
// MISSION BRIEF PROTOCOL — 7-STEP INTEL WIZARD
// ══════════════════════════════════════════════════════════════
(function initMissionBrief() {
  const panel = document.getElementById('mbrief-panel');
  if (!panel) return;

  const TOTAL_STEPS = 6;
  let currentStep = 1;

  const missionBriefData = {
    operative: '',
    email: '',
    whatsapp: '',
    institute: '',
    role: '',
    objective: '',
    objectiveOther: '',
    forceSize: '',
    deployWindow: '',
    vrHeadsets: '',
    liveDemo: ''
  };

  // ── Helpers ──
  const stepEl = (n) => document.getElementById('mb-step-0' + n);
  const questionEl = (n) => document.getElementById('mb-q-0' + n);

  const questions = [
    null,
    'What\'s your <em>name</em>?',
    'Best way to <em>reach you</em>?',
    'Where u <em>from</em>?',
    'What is your <em>objective</em>?',
    'When do you need <em>this</em>?',
    'Request <em>live demo</em>?'
  ];

  // ── Typewriter boot-in ──
  function typewriterQ(stepNum, onDone) {
    const el = questionEl(stepNum);
    if (!el) { if (onDone) onDone(); return; }
    const html = questions[stepNum];

    // Parse into char sequence with em flag
    const chars = [];
    const regex = /<em>(.*?)<\/em>|([^<]+)/g;
    let m;
    while ((m = regex.exec(html)) !== null) {
      const text = m[1] !== undefined ? m[1] : m[2];
      const isEm = m[1] !== undefined;
      [...text].forEach(c => chars.push({ c, isEm }));
    }

    // Cursor first
    el.innerHTML = '<span class="mb-cursor">|</span>';
    const delay = chars.length > 0 ? Math.min(280 / chars.length, 38) : 20;

    let i = 0;
    function tick() {
      if (i >= chars.length) {
        const cur = el.querySelector('.mb-cursor');
        if (cur) cur.remove();
        if (onDone) onDone();
        return;
      }
      const { c, isEm } = chars[i];
      const cursor = el.querySelector('.mb-cursor');
      const span = document.createElement('span');
      if (isEm) span.style.color = 'var(--orange)';
      span.textContent = c;
      if (cursor) el.insertBefore(span, cursor);
      else el.appendChild(span);
      i++;
      setTimeout(tick, delay);
    }
    tick();
  }

  // ── Progress update ──
  function updateProgress(step) {
    const pct = ((step - 1) / (TOTAL_STEPS - 1)) * 100;
    const fill   = document.getElementById('mb-progress-fill');
    const comet  = document.getElementById('mb-progress-comet');
    if (fill)  fill.style.width = pct + '%';
    if (comet) comet.style.left = pct + '%';

    const cur = panel.querySelector('.mb-step-current');
    if (cur) cur.textContent = String(step).padStart(2, '0');

    const lbl = document.getElementById('mb-step-label');
    if (lbl) lbl.textContent = 'STEP ' + String(step).padStart(2,'0') + ' / 06';

    const back = document.getElementById('mb-back-btn');
    if (back) back.style.display = step > 1 ? 'block' : 'none';
  }

  // ── INTEL LOGGED flash ──
  function flashIntel() {
    const flash = document.getElementById('mb-intel-flash');
    if (!flash) return;
    flash.style.opacity = '1';
    clearTimeout(flash._timer);
    flash._timer = setTimeout(() => { flash.style.opacity = '0'; }, 650);
  }

  // ── Chip glitch + select ──
  function selectChipIn(chipEl, groupEl, onAdvance) {
    const chips = groupEl.querySelectorAll('.mb-chip, .mb-chip-icon');
    chips.forEach(c => c.classList.remove('selected'));
    chipEl.classList.add('glitching');
    chipEl.classList.add('selected');
    setTimeout(() => chipEl.classList.remove('glitching'), 180);
    flashIntel();
    if (onAdvance) setTimeout(onAdvance, 400);
  }

  // ── Step transition ──
  function goToStep(nextStep) {
    if (nextStep < 1 || nextStep > TOTAL_STEPS) return;

    const fromEl = stepEl(currentStep);
    const toEl   = stepEl(nextStep);
    if (!fromEl || !toEl) return;

    // Exit
    fromEl.style.transition = 'opacity 220ms ease-in, transform 220ms ease-in';
    fromEl.style.opacity    = '0';
    fromEl.style.transform  = 'translateX(-20px)';

    setTimeout(() => {
      fromEl.style.display    = 'none';
      fromEl.style.opacity    = '';
      fromEl.style.transform  = '';
      fromEl.style.transition = '';

      currentStep = nextStep;
      updateProgress(currentStep);

      // Enter
      toEl.style.display       = 'flex';
      toEl.style.flexDirection = 'column';
      toEl.style.opacity       = '0';
      toEl.style.transform     = 'translateX(24px)';
      toEl.style.transition    = 'opacity 280ms cubic-bezier(0.22,1,0.36,1), transform 280ms cubic-bezier(0.22,1,0.36,1)';

      requestAnimationFrame(() => requestAnimationFrame(() => {
        toEl.style.opacity   = '1';
        toEl.style.transform = 'translateX(0)';
      }));

      typewriterQ(currentStep, () => {
        const firstInput = toEl.querySelector('.mb-input');
        if (firstInput) firstInput.focus();
      });

      setTimeout(() => { toEl.style.transition = ''; }, 300);
    }, 220);
  }

  // ── Keypress glow helper ──
  function bindInputGlow(el) {
    if (!el) return;
    el.addEventListener('input', () => {
      el.style.borderBottomColor = 'var(--cyan)';
      clearTimeout(el._gt);
      el._gt = setTimeout(() => { el.style.borderBottomColor = ''; }, 200);
    });
  }

  // ── Submit → success ──
  async function submitBrief() {
    const submitEl = panel.querySelector('.mb-demo-chip.glitching, .mb-demo-chip.selected') || panel.querySelector('.mb-demo-chip');
    const statusEl = panel.querySelector('[data-mb-status]');
    if (statusEl) statusEl.remove();
    if (submitEl) {
      submitEl.disabled = true;
      submitEl.style.pointerEvents = 'none';
      submitEl.setAttribute('aria-disabled', 'true');
    }

    try {
      const { error } = await _sb.from('leads').insert([{
        operative: missionBriefData.operative,
        email: missionBriefData.email,
        whatsapp: missionBriefData.whatsapp,
        institute: missionBriefData.institute,
        role: missionBriefData.role,
        objective: missionBriefData.objective,
        objective_other: missionBriefData.objectiveOther,
        force_size: missionBriefData.forceSize,
        deploy_window: missionBriefData.deployWindow,
        vr_headsets: missionBriefData.vrHeadsets,
        live_demo: missionBriefData.liveDemo
      }]);

      if (error) {
        if (error.message === 'rate_limit_exceeded') {
          const msg = document.createElement('div');
          msg.className = 'mb-success-sub';
          msg.dataset.mbStatus = 'true';
          msg.textContent = 'TOO MANY SIGNALS — STAND DOWN 60 MINUTES';
          panel.appendChild(msg);
          return;
        }
        console.error(error);
        const msg = document.createElement('div');
        msg.className = 'mb-success-sub';
        msg.dataset.mbStatus = 'true';
        msg.textContent = 'TRANSMISSION FAILED — RETRY';
        panel.appendChild(msg);
        return;
      }

      // Pulse panel border cyan 3×
      let n = 0;
      function pulse() {
        if (n >= 3) { showSuccess(); return; }
        panel.style.boxShadow = '0 0 0 2px var(--cyan), 0 0 20px rgba(0,212,255,0.25)';
        setTimeout(() => {
          panel.style.boxShadow = '';
          n++;
          setTimeout(pulse, 100);
        }, 200);
      }
      pulse();
    } finally {
      if (submitEl) {
        submitEl.disabled = false;
        submitEl.style.pointerEvents = '';
        submitEl.removeAttribute('aria-disabled');
      }
    }
  }

  function showSuccess() {
    // Hide all wizard chrome
    const hide = [
      document.getElementById('mb-steps-container'),
      panel.querySelector('.mb-header'),
      panel.querySelector('.mb-progress-track'),
      document.getElementById('mb-step-label'),
      document.getElementById('mb-back-btn'),
      document.getElementById('mb-intel-flash')
    ];
    hide.forEach(el => { if (el) el.style.display = 'none'; });

    const success = document.createElement('div');
    success.className = 'mb-success';
    success.innerHTML =
      '<div class="mb-scan-line"></div>' +
      '<div class="mb-success-star">✦</div>' +
      '<div class="mb-success-title">SIGNAL RECEIVED</div>' +
      '<div class="mb-success-sub">MISSION BRIEF LOGGED SUCCESSFULLY</div>' +
      '<div class="mb-success-eta">ESTIMATED CONTACT: <span>24 HOURS</span></div>';
    panel.appendChild(success);
  }

  // ════ STEP WIRING ════

  // Step 01 — OPERATIVE
  const inputOperative = document.getElementById('mb-input-operative');
  bindInputGlow(inputOperative);
  if (inputOperative) {
    inputOperative.addEventListener('keydown', (e) => {
      if (e.key === 'Enter') {
        missionBriefData.operative = inputOperative.value.trim();
        if (missionBriefData.operative) goToStep(2);
      }
    });
  }

  // Step 02 — COMMS
  bindInputGlow(document.getElementById('mb-input-email'));
  bindInputGlow(document.getElementById('mb-input-whatsapp'));
  const advance02 = document.getElementById('mb-advance-02');
  if (advance02) {
    advance02.addEventListener('click', () => {
      missionBriefData.email    = (document.getElementById('mb-input-email')?.value || '').trim();
      missionBriefData.whatsapp = (document.getElementById('mb-input-whatsapp')?.value || '').trim();
      goToStep(3);
    });
  }

  // Step 03 — HOME BASE (role chips auto-advance)
  const inputInstitute = document.getElementById('mb-input-institute');
  bindInputGlow(inputInstitute);
  const chipsRole = document.getElementById('mb-chips-role');
  if (chipsRole) {
    chipsRole.querySelectorAll('.mb-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        missionBriefData.institute = inputInstitute?.value.trim() || '';
        missionBriefData.role = chip.dataset.value;
        selectChipIn(chip, chipsRole, () => goToStep(4));
      });
    });
  }

  // Step 04 — OBJECTIVE
  const chipsObjective = document.getElementById('mb-chips-objective');
  const otherObjWrap   = document.getElementById('mb-other-obj-wrap');
  if (chipsObjective) {
    chipsObjective.querySelectorAll('.mb-chip-icon').forEach(chip => {
      chip.addEventListener('click', () => {
        chipsObjective.querySelectorAll('.mb-chip-icon').forEach(c => c.classList.remove('selected'));
        chip.classList.add('glitching');
        chip.classList.add('selected');
        setTimeout(() => chip.classList.remove('glitching'), 180);
        flashIntel();
        missionBriefData.objective = chip.dataset.value;

        if (chip.dataset.value === 'Other') {
          if (otherObjWrap) {
            otherObjWrap.style.display = 'flex';
            requestAnimationFrame(() => { otherObjWrap.style.opacity = '1'; });
            document.getElementById('mb-input-other-obj')?.focus();
          }
        } else {
          if (otherObjWrap) { otherObjWrap.style.display = 'none'; otherObjWrap.style.opacity = '0'; }
          setTimeout(() => goToStep(5), 400);
        }
      });
    });
  }
  const inputOtherObj = document.getElementById('mb-input-other-obj');
  bindInputGlow(inputOtherObj);
  const advance04 = document.getElementById('mb-advance-04');
  if (advance04) {
    advance04.addEventListener('click', () => {
      missionBriefData.objectiveOther = inputOtherObj?.value.trim() || '';
      goToStep(5);
    });
  }

  // Step 05 — READINESS (both chip groups must select before advance)
  let reconWindow = null, reconHeadsets = null;
  const advance05 = document.getElementById('mb-advance-05');

  function checkReconReady() {
    if (reconWindow && reconHeadsets && advance05) {
      advance05.style.display = 'block';
    }
  }

  const chipsWindow = document.getElementById('mb-chips-window');
  if (chipsWindow) {
    chipsWindow.querySelectorAll('.mb-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        reconWindow = chip.dataset.value;
        missionBriefData.deployWindow = reconWindow;
        chipsWindow.querySelectorAll('.mb-chip').forEach(c => c.classList.remove('selected'));
        chip.classList.add('glitching');
        chip.classList.add('selected');
        setTimeout(() => chip.classList.remove('glitching'), 180);
        flashIntel();
        checkReconReady();
      });
    });
  }

  const chipsHeadsets = document.getElementById('mb-chips-headsets');
  if (chipsHeadsets) {
    chipsHeadsets.querySelectorAll('.mb-chip').forEach(chip => {
      chip.addEventListener('click', () => {
        reconHeadsets = chip.dataset.value;
        missionBriefData.vrHeadsets = reconHeadsets;
        chipsHeadsets.querySelectorAll('.mb-chip').forEach(c => c.classList.remove('selected'));
        chip.classList.add('glitching');
        chip.classList.add('selected');
        setTimeout(() => chip.classList.remove('glitching'), 180);
        flashIntel();
        checkReconReady();
      });
    });
  }

  if (advance05) {
    advance05.addEventListener('click', () => goToStep(6));
  }

  // Step 06 — LIVE DEMO
  panel.querySelectorAll('.mb-demo-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      missionBriefData.liveDemo = chip.dataset.value;
      chip.classList.add('glitching');
      setTimeout(() => chip.classList.remove('glitching'), 180);
      flashIntel();
      setTimeout(() => submitBrief(), 450);
    });
  });

  // Back button
  const backBtn = document.getElementById('mb-back-btn');
  if (backBtn) {
    backBtn.addEventListener('click', () => {
      if (currentStep > 1) goToStep(currentStep - 1);
    });
  }

  // ── Initialise: show step 1 ──
  updateProgress(1);
  const s1 = stepEl(1);
  if (s1) { s1.style.display = 'flex'; s1.style.flexDirection = 'column'; }
  typewriterQ(1, () => {
    document.getElementById('mb-input-operative')?.focus();
  });

})();

// ── Hero CTA scroll handlers ──
(function() {
  function smoothTo(id) {
    const el = document.getElementById(id);
    if (!el) return;
    if (window.__lenis) {
      window.__lenis.scrollTo(el, { offset: 0 });
    } else {
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
  document.getElementById('btn-explore')?.addEventListener('click', () => smoothTo('section-2'));
  // btn-demo now opens Mission Brief modal (wired in modal JS block)
})();

// ── Nav item scroll hooks ──
(function() {
  function navScrollTo(id) {
    const el = document.getElementById(id);
    if (!el) return;
    if (window.__lenis) {
      window.__lenis.scrollTo(el, { offset: 0, duration: 1.2 });
    } else {
      el.scrollIntoView({ behavior: 'smooth', block: 'start' });
    }
  }
  document.querySelectorAll('.ni[data-target]').forEach(function(item) {
    item.addEventListener('click', function() {
      navScrollTo(this.dataset.target);
    });
  });
})();

// ── Social Redirect Modal ──
(function() {
  const modal    = document.getElementById('redirect-modal');
  const icon     = document.getElementById('rdm-icon');
  const title    = document.getElementById('rdm-title');
  const desc     = document.getElementById('rdm-desc');
  const confirm  = document.getElementById('rdm-confirm');
  const cancel   = document.getElementById('rdm-cancel');
  let   pending  = null;

  const configs = {
    ig: {
      icon:    '📸',
      title:   'Instagram',
      desc:    'You will be redirected to<br><span>@neovrit</span> on Instagram.',
      url:     'https://www.instagram.com/neovrit?igsh=ZWptcjUwNHhpczdk',
      btnCls:  'ig',
      btnText: 'Open Instagram →'
    },
    gm: {
      icon:    '✉️',
      title:   'Gmail',
      desc:    'This will open your email client to contact<br><span>future4orge@gmail.com</span>',
      url:     'mailto:future4orge@gmail.com',
      btnCls:  '',
      btnText: 'Open Email →'
    }
  };

  function openModal(type) {
    const c = configs[type];
    pending = c.url;
    icon.textContent     = c.icon;
    title.textContent    = c.title;
    desc.innerHTML       = c.desc;
    confirm.textContent  = c.btnText;
    confirm.className    = 'rdm-confirm' + (c.btnCls ? ' ' + c.btnCls : '');
    modal.classList.add('open');
  }

  function closeModal() {
    modal.classList.remove('open');
    pending = null;
  }

  document.getElementById('nav-ig')?.addEventListener('click', () => openModal('ig'));
  document.getElementById('nav-gm')?.addEventListener('click', () => openModal('gm'));

  confirm.addEventListener('click', () => {
    if (pending) { window.open(pending, '_blank', 'noopener,noreferrer'); }
    closeModal();
  });

  cancel.addEventListener('click', closeModal);

  // Close on backdrop click
  modal.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });

  // Close on Escape
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') closeModal();
  });
})();

</script>


<!-- ══════════════════════════════════════
     MISSION BRIEF MODAL OVERLAY
     ══════════════════════════════════════ -->
<div id="mbrief-overlay">
  <!-- clicking backdrop closes -->
</div>


<script>
// ── MISSION BRIEF MODAL LOGIC ──────────────────────────────────────────
(function() {
  const overlay  = document.getElementById('mbrief-overlay');
  const panel    = document.getElementById('mbrief-panel');
  if (!overlay || !panel) return;

  // Move panel into overlay
  overlay.appendChild(panel);

  // Add close button
  const closeBtn = document.createElement('button');
  closeBtn.id = 'mbrief-close';
  closeBtn.setAttribute('aria-label', 'Close');
  closeBtn.innerHTML = '✕';
  panel.insertBefore(closeBtn, panel.firstChild);

  function openModal() {
    overlay.classList.add('open');
    document.body.style.overflow = 'hidden';
    // Focus first input after animation
    setTimeout(() => {
      const firstInput = document.getElementById('mb-input-operative');
      if (firstInput) firstInput.focus();
    }, 400);
  }

  function closeModal() {
    overlay.classList.remove('open');
    document.body.style.overflow = '';
  }

  // Close on backdrop click
  overlay.addEventListener('click', function(e) {
    if (e.target === overlay) closeModal();
  });

  // Close on Escape
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeModal();
  });

  closeBtn.addEventListener('click', closeModal);

  // Hero "Book a Demo" button
  const btnDemo = document.getElementById('btn-demo');
  if (btnDemo) {
    btnDemo.addEventListener('click', function(e) {
      e.stopPropagation();
      openModal();
    });
  }

  // Contact section "Request Live Demo" button
  const btnStartBrief = document.getElementById('btn-start-brief');
  if (btnStartBrief) {
    btnStartBrief.addEventListener('click', function(e) {
      e.stopPropagation();
      openModal();
    });
  }

  // Override the old scroll-to logic that was wired to btn-start-brief
  // (original handler is harmless since we stopPropagation above)
})();
</script>


<script>
  window.addEventListener('DOMContentLoaded', () => {
    // 1. Expose the existing setRenderMode & setTransformerView
    window.setRenderMode = (typeof setRenderMode === 'function') ? setRenderMode : function(){};
    window.setTransformerView = (typeof setTransformerView === 'function') ? setTransformerView : function(){};
    
    // 2. Attach click listeners for rendering modes
    document.querySelectorAll('.render-toggle-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const mode = btn.dataset.mode;
        if (mode && typeof setRenderMode === 'function') {
          // Explicitly update all materials immediately without animation delay
          const activeScene = window.scene;
          if (activeScene) {
            activeScene.traverse((child) => {
              if (child.isMesh && child.userData.matSet && child.userData.matSet[mode]) {
                child.material = child.userData.matSet[mode];
                child.material.needsUpdate = true;
              }
            });
            if (window.renderer && window.camera) window.renderer.render(window.scene, window.camera);
          }
          setRenderMode(mode);
        }
      });
    });
    
    document.querySelectorAll('.transformer-toggle-btn').forEach((btn) => {
      btn.addEventListener('click', (e) => {
        const view = btn.dataset.view;
        if (view && typeof setTransformerView === 'function') setTransformerView(view);
      });
    });

    // 3. Intro Loading Progress Animation
    const pctEl = document.getElementById('intro-pct');
    const fillEl = document.getElementById('intro-progress-fill');
    const enterBtn = document.getElementById('intro-enter-btn');
    const skipBtn = document.getElementById('intro-skip');
    
    let currentPct = 0;
    const startTime = performance.now();
    const duration = 1800; // 1.8 seconds

    function dismissIntroScreen() {
      const intro = document.getElementById('intro-screen');
      if (intro && intro.style.display !== 'none') {
        intro.style.transition = 'opacity 0.6s ease, transform 0.6s cubic-bezier(0.16, 1, 0.3, 1)';
        intro.style.opacity = '0';
        intro.style.transform = 'translateY(-100%)';
        setTimeout(() => {
          intro.style.display = 'none';
          intro.style.pointerEvents = 'none';
        }, 650);
      }
    }

    function updateIntroProgress(now) {
      const elapsed = now - startTime;
      const progress = Math.min(1.0, elapsed / duration);
      const eased = 1 - (1 - progress) * (1 - progress);
      currentPct = Math.floor(eased * 100);

      if (pctEl) pctEl.textContent = currentPct + '%';
      if (fillEl) fillEl.style.width = currentPct + '%';

      if (progress < 1.0) {
        requestAnimationFrame(updateIntroProgress);
      } else {
        if (pctEl) pctEl.textContent = '100%';
        if (fillEl) fillEl.style.width = '100%';
        
        setTimeout(() => { dismissIntroScreen(); }, 350);
      }
    }

    requestAnimationFrame(updateIntroProgress);

    if (enterBtn) enterBtn.addEventListener('click', dismissIntroScreen);
    if (skipBtn) skipBtn.addEventListener('click', dismissIntroScreen);
  });
</script>

</body>
</html>
