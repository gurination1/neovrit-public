        </div>

        <!-- STEP 06 — LIVE DEMO -->
        <div class="mb-step" id="mb-step-06">
          <div class="mb-question" id="mb-q-06"></div>
          <div class="mb-sub-label">A live demo request marks you as a priority contact.</div>
          <div class="mb-demo-chips">
