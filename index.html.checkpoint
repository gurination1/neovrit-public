        <!-- STEP 03 — HOME BASE -->
        <div class="mb-step" id="mb-step-03">
          <div class="mb-question" id="mb-q-03"></div>
          <input type="text" class="mb-input" id="mb-input-institute" placeholder="e.g. IIT Delhi, MIT, Oxford…" autocomplete="off" />
          <div class="mb-chip-label">YOUR ROLE</div>
          <div class="mb-chip-row" id="mb-chips-role">
            <div class="mb-chip" data-value="STUDENT">STUDENT</div>
            <div class="mb-chip" data-value="FACULTY">FACULTY</div>
            <div class="mb-chip" data-value="ADMIN">ADMIN</div>
            <div class="mb-chip" data-value="MANAGEMENT">MANAGEMENT</div>
          </div>
        </div>

        <!-- STEP 04 — OBJECTIVE -->
        <div class="mb-step" id="mb-step-04">
          <div class="mb-question" id="mb-q-04"></div>
          <div class="mb-sub-label">Select primary VR deployment use case.</div>
          <div class="mb-chip-grid" id="mb-chips-objective">
            <div class="mb-chip-icon" data-value="Physics Lab">🔬<br/>Physics Lab</div>
            <div class="mb-chip-icon" data-value="Chemistry Lab">⚗️<br/>Chemistry Lab</div>
            <div class="mb-chip-icon" data-value="Engineering Lab">⚙️<br/>Engineering Lab</div>
            <div class="mb-chip-icon mb-chip-usp-wrap" data-value="Interview Training">🎤<br/>Interview Training<span class="mb-usp-badge">USP</span></div>
            <div class="mb-chip-icon" data-value="Army Simulation">🪖<br/>Army Simulation</div>
            <div class="mb-chip-icon mb-chip-other-obj" data-value="Other">＋<br/>Other</div>
          </div>
          <div class="mb-other-wrap" id="mb-other-obj-wrap">
            <input type="text" class="mb-input" id="mb-input-other-obj" placeholder="Describe your use case..." autocomplete="off" />
            <button class="mb-advance-btn" id="mb-advance-04">CONFIRM &amp; ADVANCE →</button>
          </div>
        </div>

        <!-- STEP 05 — READINESS -->
        <div class="mb-step" id="mb-step-05">
          <div class="mb-chip-label mb-chip-label-highlight" id="mb-q-05"></div>
          <div class="mb-chip-row" id="mb-chips-window">
            <div class="mb-chip" data-value="Just Exploring">Just Exploring</div>
            <div class="mb-chip" data-value="Within 3 Months">Within 3 Months</div>
            <div class="mb-chip" data-value="Immediately">🔥 Immediately</div>
          </div>
          <div class="mb-chip-label mb-chip-label-highlight mb-chip-label-vr">Do you have VR headsets?</div>
          <div class="mb-chip-row" id="mb-chips-headsets">
            <div class="mb-chip" data-value="Yes">✅ Yes, We Have</div>
            <div class="mb-chip" data-value="Planning">📦 Planning to Buy</div>
            <div class="mb-chip" data-value="No">❌ Not Yet</div>
          </div>
